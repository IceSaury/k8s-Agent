# ============================================================
# K8s 运维助手 Agent —— 环境变量模板
# 复制为 .env 后填写真实值：cp .env.example .env
# .env 已被 .gitignore 排除，不要提交
# ============================================================

# === LLM 配置（方式1：OpenAI 或任意兼容接口，本项目用 DashScope 兼容模式）===
LLM_PROVIDER=openai
LLM_MODEL=qwen-plus
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# === K8s MCP Server 配置 ===
# mcp-k8s-eye 部署在虚拟机上，当前以 SSE 方式提供（endpoint 路径必须以 /sse 结尾）
K8S_MCP_URL=http://192.168.150.101:8080/sse
# 传输方式：sse | streamable_http
# PDF §2.3 写的是 streamable_http，但实际部署是 SSE，故这里以 sse 为默认值。
# 等 Server 升级为 HTTP 流式接口后，只改这一行即可，代码无需改动。
K8S_MCP_TRANSPORT=sse
# 工具发现超时（秒）。虚拟机没开机时，用它快速失败以便回退到 mock 工具
K8S_MCP_TIMEOUT=10
# 单次工具调用超时（秒）。个别工具对某些入参不响应（服务端掐断连接、不回数据），
# 没有这道闸门时整轮对话会一直挂住。超时后把错误文本回给 LLM，让它换工具或换参数重试
TOOL_CALL_TIMEOUT=30

# === 对话记忆 ===
# 记忆窗口（轮）。超过后最老的整轮对话会从历史中删除；同时发给模型时，
# 已结束旧轮的工具结果会被替换成占位符（工具原文动辄上百 KB，不清理会让后续轮次越来越慢）
MEMORY_WINDOW_ROUNDS=10

# === 搜索工具配置 ===
# duckduckgo（默认，免费无需 Key） | tavily（备选，需 API Key）
# DuckDuckGo 在本机网络下不可直连（后端走 search.yahoo.com，连接被拒绝），
# 必须配代理：把代理地址填到 SEARCH_PROXY，例如 http://127.0.0.1:7892
SEARCH_PROVIDER=duckduckgo
SEARCH_MAX_RESULTS=5
SEARCH_PROXY=
SEARCH_TIMEOUT=10
# TAVILY_API_KEY=tvly-REPLACE_ME

# === 离线开发开关 ===
# MCP Server 不可达时，用内置 mock 工具跑通 Agent 主逻辑。
# 真机联调时改为 false，强制要求连真实集群。
ALLOW_MCP_FALLBACK=true

# === 飞书机器人配置（阶段6 才用到，先留占位）===
# 飞书自建应用的凭证，在 开放平台 > 你的应用 > 凭证与基础配置 中获取
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 事件订阅方式：ws = 长连接（本地开发无需公网 IP）| webhook = 回调地址（需公网）
FEISHU_CONNECTION_MODE=ws
